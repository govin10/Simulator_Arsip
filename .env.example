# URL Postgres (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# String acak minimal 32 karakter untuk menandatangani cookie login
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Token Vercel Blob (otomatis terisi bila Blob dihubungkan di tab Storage Vercel)
# BLOB_READ_WRITE_TOKEN=""
