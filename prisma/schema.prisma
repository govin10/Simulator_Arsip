generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubmissionStatus {
  SUBMITTED /// sudah dikumpulkan, menunggu dinilai
  REVISION  /// dikembalikan guru, siswa boleh mengunggah ulang
  GRADED    /// sudah dinilai
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  name         String
  passwordHash String
  role         Role         @default(STUDENT)
  classroomId  String?
  classroom    Classroom?   @relation("ClassStudents", fields: [classroomId], references: [id], onDelete: SetNull)
  teaching     Classroom[]  @relation("ClassTeacher")
  assignments  Assignment[]
  submissions  Submission[] @relation("StudentSubmissions")
  graded       Submission[] @relation("GradedBy")
  createdAt    DateTime     @default(now())
}

/// Kelas. Bisa dibuat guru, atau otomatis saat siswa mendaftar (teacherId kosong = terlihat semua guru).
model Classroom {
  id          String       @id @default(cuid())
  name        String       @unique
  teacherId   String?
  teacher     User?        @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  students    User[]       @relation("ClassStudents")
  assignments Assignment[]
  createdAt   DateTime     @default(now())
}

/// Tugas dari guru. Soal diberikan di kertas; di sini hanya judul, petunjuk, dan tenggat.
model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dueAt       DateTime?
  allowLate   Boolean      @default(true)
  isOpen      Boolean      @default(true)
  maxScore    Int          @default(100)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// Satu pengumpulan per siswa per tugas. Unggah ulang mengganti file lama.
model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  fileKey      String           /// URL Vercel Blob atau path lokal (tidak pernah dikirim ke browser)
  fileName     String
  fileSize     Int
  submittedAt  DateTime         @default(now())
  uploadCount  Int              @default(1)
  status       SubmissionStatus @default(SUBMITTED)
  score        Float?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?            @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
}
